-- ============================================================
-- recipe_load.kl
-- Reads a recipe XML file and copies it into registers.
--   ?value=VIEW -> edit side   (SR[2], R[11..13])  : just look / modify
--   ?value=LOAD -> active side (SR[3], R[1..3])    : what the robot uses
-- SR[1] = recipe selected in the combo box (file name + ".xml")
-- ============================================================
PROGRAM recipe_load
%NOLOCKGROUP
%NOPAUSESHFT
%ENVIRONMENT REGOPE
%NOPAUSE = ERROR + COMMAND + TPENABLE
%NOABORT = ERROR + COMMAND
%ENVIRONMENT xml
%ENVIRONMENT MULTI
%INCLUDE klerxmlf

CONST
    MYXML_CONST = 3

VAR
    value       : STRING[12]
    xml_file    : FILE
    xml_path    : STRING[50]
    sel_name    : STRING[50]
    rname       : STRING[50]
    status      : INTEGER
    -- XML scan helpers
    tag_name    : STRING[32]
    tag_ident   : INTEGER
    func_code   : INTEGER
    text_idx    : INTEGER
    numattr     : INTEGER
    textdone    : BOOLEAN
    done        : BOOLEAN
    startdata   : BOOLEAN
    text        : ARRAY[32] OF STRING[128]
    attrnames   : ARRAY[32] OF STRING[32]
    attrvalues  : ARRAY[32] OF STRING[64]
    -- values read from the file
    v_name      : STRING[50]
    v_length    : STRING[50]
    v_width     : STRING[50]
    v_height    : STRING[50]
    r_length    : REAL
    r_width     : REAL
    r_height    : REAL
    return_code : INTEGER

-- Opens the XML, looks for ONE tag and returns the attribute value of that tag
ROUTINE read_tag(tag : STRING) : STRING
BEGIN
    attrvalues[1] = ''
    CLR_IO_STAT(xml_file)
    SET_FILE_ATR(xml_file, ATR_XML)
    OPEN FILE xml_file ('RO', xml_path)
    status = IO_STATUS(xml_file)
    IF status <> 0 THEN
        POST_ERR(status, '', 0, 0)
        ABORT
    ENDIF

    XML_ADDTAG(xml_file, tag, 32, FALSE, MYXML_CONST, status)

    textdone = TRUE
    done = FALSE
    startdata = FALSE
    WHILE (done = FALSE) DO
        XML_SCAN(xml_file, tag_name, tag_ident, func_code, status)
        IF (status = 0) THEN
            done = TRUE
        ENDIF
        IF (status = XML_FUNCTION) THEN
            status = 0
            SELECT tag_ident OF
                CASE (MYXML_CONST):
                    SELECT func_code OF
                        CASE (XML_START):
                            text_idx = 1
                            XML_GETDATA(xml_file, numattr, attrnames, attrvalues, text[text_idx], textdone, status)
                            startdata = TRUE
                        CASE (XML_END):
                            IF (startdata = TRUE) THEN
                                startdata = FALSE
                            ELSE
                                text_idx = 1
                                XML_GETDATA(xml_file, numattr, attrnames, attrvalues, text[text_idx], textdone, status)
                            ENDIF
                        CASE (XML_TXCONT):
                            text_idx = text_idx + 1
                            XML_GETDATA(xml_file, numattr, attrnames, attrvalues, text[text_idx], textdone, status)
                        ELSE:
                    ENDSELECT
                ELSE:
            ENDSELECT
        ELSE
            IF (status <> XML_SCANLIM) THEN
                POST_ERR(status, '', 0, 0)
                done = TRUE
            ENDIF
        ENDIF
    ENDWHILE

    XML_REMTAG(xml_file, tag, status)
    CLOSE FILE xml_file
    CLR_IO_STAT(xml_file)
    RETURN (attrvalues[1])
END read_tag

BEGIN
    IF UNINIT(value) THEN
        value = ''
    ENDIF

    GET_STR_REG(1, sel_name, status)
    IF STR_LEN(sel_name) > 4 THEN
        -- strip the ".xml" from the combo box item
        rname = SUB_STR(sel_name, 1, STR_LEN(sel_name) - 4)
        xml_path = 'fr:\recipes\' + rname + '.xml'

        v_name   = read_tag('recipename')
        v_length = read_tag('length')
        v_width  = read_tag('width')
        v_height = read_tag('height')

        CNV_STR_REAL(v_length, r_length)
        CNV_STR_REAL(v_width,  r_width)
        CNV_STR_REAL(v_height, r_height)

        IF value = 'VIEW' THEN
            SET_STR_REG(2, v_name, status)
            SET_REAL_REG(11, r_length, status)
            SET_REAL_REG(12, r_width,  status)
            SET_REAL_REG(13, r_height, status)
        ENDIF

        IF value = 'LOAD' THEN
            SET_STR_REG(3, v_name, status)
            SET_REAL_REG(1, r_length, status)
            SET_REAL_REG(2, r_width,  status)
            SET_REAL_REG(3, r_height, status)
        ENDIF
    ENDIF

    return_code = 204
END recipe_load
